# Face Recognition Service - optional configuration
#
# Copy this file to `.env` in the project folder and edit the values you need.
# Real environment variables always take precedence over this file.
# The `.env` file is ignored by git.

# ---------------------------------------------------------------------------
# Paths
# ---------------------------------------------------------------------------

# Folder that stores one sub-folder per registered person.
# Relative paths are resolved from the project folder.
# Default: faces
#FACE_DATABASE_PATH=faces

# Folder where DeepFace stores model weights. DeepFace creates a `.deepface`
# sub-folder inside this path, so set it to your home folder, not to `.deepface`
# itself. Default: your home folder (weights end up in ~/.deepface/weights).
#DEEPFACE_HOME=

# Where the embedding cache is written.
# Default: <FACE_DATABASE_PATH>/.embeddings_cache.npz
#FACE_EMBEDDING_CACHE_PATH=

# Set to 0 to disable the embedding cache (slower startup, no cache file).
#FACE_EMBEDDING_CACHE=1

# If the face detector fails (for example in a dim room), retry with a
# MediaPipe face crop. Set to 0 to disable the fallback.
#FACE_MEDIAPIPE_FALLBACK=1

# ---------------------------------------------------------------------------
# Recognition
# ---------------------------------------------------------------------------

# ArcFace cosine-distance threshold. Lower is stricter.
# DeepFace's published ArcFace threshold is 0.68.
#FACE_MATCH_THRESHOLD=0.68

# Required difference between the best and second-best identity.
#FACE_MATCH_MARGIN=0.05

# DeepFace model and detector. The defaults are the tested configuration.
#FACE_MODEL_NAME=ArcFace
#FACE_DETECTOR_BACKEND=opencv

# Advanced: force a DeepFace backend. The default (onnx) needs only
# onnxruntime. Setting this to tensorflow requires tensorflow and tf-keras.
#DEEPFACE_BACKEND_ENGINE=onnx

# ---------------------------------------------------------------------------
# Camera
# ---------------------------------------------------------------------------

# Webcam index. Try 1, 2, ... if index 0 is not your camera.
#FACE_CAMERA_INDEX=0

# auto (recommended), dshow, msmf, v4l2, avfoundation, gstreamer or any.
#FACE_CAMERA_BACKEND=auto

# ---------------------------------------------------------------------------
# Registration
# ---------------------------------------------------------------------------

# Consecutive frames required before a pose is captured.
#FACE_STABLE_FRAMES=8

# Head-pose thresholds in degrees.
#FACE_YAW_THRESHOLD=15
#FACE_PITCH_THRESHOLD=12

# Maximum registration duration in seconds (0 disables the limit).
#FACE_REGISTRATION_TIMEOUT=300

# ---------------------------------------------------------------------------
# Troubleshooting
# ---------------------------------------------------------------------------

# Set to 1 to print full Python tracebacks for unexpected errors.
#FACE_DEBUG=0

# Set to 1 only if you intentionally use an unsupported Python version.
#FACE_SKIP_PYTHON_CHECK=0
